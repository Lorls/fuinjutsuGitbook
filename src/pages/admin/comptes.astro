---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireStaff } from '../../lib/guard';
import { db } from '../../lib/db';

const denied = requireStaff(Astro);
if (denied) return denied;

const user = Astro.locals.user!;
const rows = db
  .prepare('SELECT id, username, rank_level, is_staff, created_at FROM users ORDER BY is_staff DESC, username')
  .all() as Array<{ id: number; username: string; rank_level: number; is_staff: number; created_at: string }>;
const msg = Astro.url.searchParams.get('msg');
const pw = Astro.url.searchParams.get('pw');
const credUser = Astro.url.searchParams.get('user');
const ranks = [1, 2, 3, 4, 5];
---

<AdminLayout title="Comptes" active="comptes">
  <div class="admin-page">
    <header class="admin-head">
      <p class="archive-index">Console staff</p>
      <h1>Comptes</h1>
      <p class="admin-lede">Crée les comptes des joueurs et fixe leur rang. Le mot de passe est généré automatiquement.</p>
    </header>

    {pw && (
      <div class="admin-creds">
        <div class="admin-creds-body">
          <p class="admin-creds-title">Identifiants générés — à transmettre au joueur</p>
          <p class="admin-creds-line"><span>Utilisateur</span><code>{credUser}</code><span>Mot de passe</span><code data-pw>{pw}</code></p>
          <p class="admin-creds-note">⚠️ Affiché une seule fois — note-le maintenant.</p>
        </div>
        <button type="button" class="button button--ink" data-copy-pw>Copier</button>
      </div>
    )}

    {msg && !pw && <p class="admin-msg">{msg}</p>}

    <section class="admin-block">
      <h2>Nouveau compte</h2>
      <form class="admin-form admin-form--create" method="post" action="/api/admin/users">
        <input type="hidden" name="action" value="create" />
        <label>Nom<input name="username" required autocomplete="off" /></label>
        <label>Rang<select name="rank">{ranks.map((r) => <option value={r}>Cercle {r}</option>)}</select></label>
        <label class="admin-check"><input type="checkbox" name="is_staff" value="1" /> Staff</label>
        <button type="submit" class="button button--ink">Créer le compte</button>
      </form>
    </section>

    <section class="admin-block">
      <h2>Comptes existants · {rows.length}</h2>
      <div class="admin-table">
        {rows.map((u) => (
          <div class="admin-row">
            <div class="admin-id">
              <span class="admin-avatar">{u.username.charAt(0).toUpperCase()}</span>
              <div>
                <strong>{u.username}</strong>
                <small>{u.is_staff ? 'Staff · voit tout' : `Cercle ${u.rank_level}`}</small>
              </div>
            </div>
            <div class="admin-actions">
              <form class="admin-inline" method="post" action="/api/admin/users">
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="id" value={u.id} />
                <select name="rank">{ranks.map((r) => <option value={r} selected={r === u.rank_level}>Cercle {r}</option>)}</select>
                <label class="admin-check"><input type="checkbox" name="is_staff" value="1" checked={!!u.is_staff} /> Staff</label>
                <button type="submit">Enregistrer</button>
              </form>
              <form class="admin-inline" method="post" action="/api/admin/users" onsubmit="return confirm('Générer un nouveau mot de passe pour ce compte ?')">
                <input type="hidden" name="action" value="password" />
                <input type="hidden" name="id" value={u.id} />
                <button type="submit">Nouveau mdp</button>
              </form>
              {u.id !== user.id && (
                <form class="admin-inline" method="post" action="/api/admin/users" onsubmit="return confirm('Supprimer ce compte ?')">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={u.id} />
                  <button type="submit" class="admin-danger">Supprimer</button>
                </form>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  document.querySelector('[data-copy-pw]')?.addEventListener('click', (e) => {
    const pw = document.querySelector('[data-pw]')?.textContent ?? '';
    if (pw && navigator.clipboard) {
      navigator.clipboard.writeText(pw);
      const btn = e.currentTarget as HTMLButtonElement;
      const label = btn.textContent;
      btn.textContent = 'Copié ✓';
      setTimeout(() => { btn.textContent = label; }, 1500);
    }
  });
  // Nettoie l'URL (retire msg/pw) après affichage.
  if (/[?&](msg|pw)=/.test(location.search)) {
    history.replaceState(null, '', location.pathname);
  }
</script>
